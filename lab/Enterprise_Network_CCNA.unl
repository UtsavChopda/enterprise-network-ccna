<?xml version='1.0' encoding='utf-8'?>
<lab name="Enterprise_Network_CCNA" version="1" scripttimeout="300" lock="0">
  <description>Utsav Chopda | Isolated enterprise lab | 6 x 1024 MB network nodes | Apply supplied console configs after import. No external clouds.</description>
